:root {
  --blog-accent: #854653;
  --blog-muted: #61605d;
  --blog-border: #e7e2dc;
  --blog-card: #fbf9f6;
  --blog-monogram-bg: #ebe2d8;
  --blog-monogram-fg: #654a3e;
  --blog-serif: 'Noto Serif SC', 'Songti SC', 'SimSun', 'Georgia', serif;
}

@media (prefers-color-scheme: dark) {
  :root {
    --blog-accent: #efaab8;
    --blog-muted: #c2bcb5;
    --blog-border: #504943;
    --blog-card: #2b2725;
    --blog-monogram-bg: #503a38;
    --blog-monogram-fg: #f5d8cd;
  }
}

body {
  font-family: var(--blog-serif);
}

:is(.site-title, .post-title, .post-body h2, .post-body h3) {
  font-family: var(--blog-serif);
}

.brand {
  padding-inline: 32px;
}

.site-title {
  font-family: 'Ma Shan Zheng', 'Kaiti SC', 'STKaiti', 'KaiTi', var(--blog-serif);
  font-size: 1.75rem;
  letter-spacing: .18em;
  padding-inline-start: .18em;
}

.post-body {
  font-size: 1rem;
  line-height: 1.95;
  overflow-wrap: anywhere;
}

.friend-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  padding: 0;
  margin: 24px 0 0;
  list-style: none;
}

.friend-grid li {
  min-width: 0;
}

.post-body .friend-card {
  display: flex;
  align-items: center;
  gap: 14px;
  min-height: 80px;
  padding: 12px 16px;
  border: 1px solid var(--blog-border);
  border-radius: 6px;
  background: var(--blog-card);
  color: inherit;
  text-decoration: none;
  transition: transform .16s ease, border-color .16s ease;
}

.post-body .friend-card:focus-visible {
  outline: 2px solid var(--blog-accent);
  outline-offset: 3px;
}

:is(.toggle, .popup-trigger, .popup-btn-close, .back-to-top, .sidebar-nav li):focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 2px;
}

@media (hover: hover) {
  .post-body .friend-card:hover {
    transform: translateY(-2px);
    border-color: var(--blog-accent);
  }
}

.post-body .friend-avatar {
  flex: 0 0 44px;
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  margin: 0;
  border-radius: 5px;
  background: var(--blog-monogram-bg);
  color: var(--blog-monogram-fg);
  font-size: 1.125rem;
  font-weight: 700;
  object-fit: cover;
}

.friend-details {
  display: grid;
  gap: 3px;
  min-width: 0;
  line-height: 1.5;
}

.friend-card:is(:hover, :focus-visible) strong {
  color: var(--blog-accent);
}

.friend-details span {
  color: var(--blog-muted);
  font-size: .875rem;
}

.site-author-image {
  box-sizing: border-box;
  width: 88px;
  height: 88px;
  max-width: 88px;
  object-fit: cover;
  object-position: center;
}

@media (max-width: 767px) {
  .friend-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}

@media (prefers-reduced-motion: reduce) {
  .post-body .friend-card {
    transition: none;
  }

  .post-body .friend-card:hover {
    transform: none;
  }
}
